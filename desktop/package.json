{
  "name": "viendu-desktop",
  "version": "0.1.7",
  "private": true,
  "main": "dist/adventureMain.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.cjs",
    "start": "npm run build && npm run prepare:web && electron .",
    "prepare:web": "node prepare-web.cjs",
    "package:win": "npm run build && npm run prepare:web && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Viễn Du — Focus and learning adventure",
  "author": "Vien Du",
  "build": {
    "appId": "com.viendu.study",
    "productName": "Vien Du",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "web-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Vien-Du-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
