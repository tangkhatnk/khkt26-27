{
  "name": "viendu",
  "version": "0.1.7",
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "officeparser": "8.1.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "prestart": "node scripts/start.mjs --prepare-only",
    "predev": "node scripts/prepare-material-worker.mjs",
    "preweb": "node scripts/prepare-material-worker.mjs",
    "prebuild:web": "node scripts/prepare-material-worker.mjs",
    "start": "node scripts/start.mjs",
    "start:production": "node scripts/start-production.mjs",
    "dev": "node scripts/start-local.mjs",
    "web": "node scripts/start-local.mjs",
    "build:web": "vite build && node scripts/build-web.mjs",
    "build": "npm run build:web && npm --prefix backend run db:generate && npm --prefix backend run build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts scripts tests eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test:web": "node --test tests/*.test.mjs",
    "test:backend": "npm --prefix backend test"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
