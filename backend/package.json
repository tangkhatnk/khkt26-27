{
  "name": "pomodoro-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "db:local": "tsx scripts/dev-local.ts --db-only",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^2.27.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "ioredis-mock": "^8.13.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
