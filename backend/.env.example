DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pomodoro
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# CORS hiện dùng origin: true trong app.ts; CORS_ORIGIN chưa áp dụng.
CORS_ORIGIN=http://localhost:8081
S3_BUCKET=pomodoro-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=local-minio
S3_SECRET_ACCESS_KEY=local-minio-password
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional overload fallback. Set to an empty value to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: token riêng cho Prometheus, ít nhất 32 ký tự.
# METRICS_TOKEN=replace-with-a-random-monitoring-token
