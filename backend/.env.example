DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pomodoro
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional backend-only admin allowlist; comma-separated account UUIDs. Empty denies all admin routes.
ADMIN_USER_IDS=
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# CORS hiện dùng origin: true trong app.ts; CORS_ORIGIN chưa áp dụng.
CORS_ORIGIN=http://localhost:8081
S3_BUCKET=pomodoro-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=local-minio
S3_SECRET_ACCESS_KEY=local-minio-password
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Google AI Studio API key (including newer AQ authorization keys).
# Backend only: never prefix this with VITE_ or put it in frontend configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional workload-specific models; each defaults to GEMINI_MODEL when unset.
# GEMINI_TUTOR_MODEL=gemini-3.8-flash
# GEMINI_QUESTION_MODEL=gemini-3.8-flash
# GEMINI_EVALUATION_MODEL=gemini-3.8-flash
# Fast PDF/image transcription, independent from the question model.
GEMINI_READING_MODEL=gemini-3.5-flash-lite
# Optional fallback for explicit provider overload/deadline errors, within one overall deadline. Set empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Guest AI quota caps. Per-IP limits use Fastify's socket IP until a trusted proxy is explicitly configured.
# The shared provider ceiling is 1,000,000 internal units per day (tunable below), not billed token counts.
# Worst-case route reservations: 10,000 read, 2,000 summary, 4,000 guide, 6,000 quiz,
# 12,000 generated exercise set, and 8,000 exercise solutions. One maximum study path
# reserves about 42,000 units; a credential is capped at 50,000 per day by default,
# while the shared ceiling admits about 23 maximum paths. Exhaustion returns HTTP 429
# until the next UTC day; configure the shared ceiling for expected classroom traffic.
GUEST_AI_PER_IP_DAILY_ISSUE_LIMIT=5000
GUEST_AI_GLOBAL_DAILY_ISSUE_LIMIT=20000
GUEST_AI_PER_IP_DAILY_REQUEST_LIMIT=10000
GUEST_AI_PER_CREDENTIAL_DAILY_UNITS=50000
GUEST_AI_GLOBAL_DAILY_UNITS=1000000
GUEST_AI_DOCUMENT_DAILY_REQUESTS=8
GUEST_AI_TUTOR_DAILY_REQUESTS=8
GUEST_AI_QUESTION_DAILY_REQUESTS=10
GUEST_AI_EVALUATION_DAILY_REQUESTS=30
GUEST_AI_SESSION_DAILY_REQUESTS=100

# Optional: token riêng cho Prometheus, ít nhất 32 ký tự.
# METRICS_TOKEN=replace-with-a-random-monitoring-token
